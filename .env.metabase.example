# Copy to .env.metabase, set unique high-entropy secrets, never commit the result.
# Keep existing .env and use BOTH files with --env-file in Compose.
MB_APP_DB_NAME=metabase_app
MB_APP_DB_USER=metabase_app
MB_APP_DB_PASSWORD=CHANGE_ME_RANDOM_LONG_SECRET_1
MB_READER_USER=metabase_reader
MB_READER_PASSWORD=CHANGE_ME_RANDOM_LONG_SECRET_2
MB_CH_READER_PASSWORD=CHANGE_ME_RANDOM_LONG_SECRET_3
MB_ENCRYPTION_SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_BASE64_OR_HEX_STRING
MB_SITE_URL=http://localhost:3001
MB_PORT=3001
# For post-setup, export an admin-level Metabase API key in the terminal:
# export METABASE_API_KEY=... (never store it in Git or bootstrap output)
