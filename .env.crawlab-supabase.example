# COPY to .env.crawlab-supabase, fill locally; NEVER commit that file.
# Copy a connection URL from Supabase Dashboard > Connect > Session pooler.
# Use a DEDICATED database role (collector_runtime), not postgres or service_role.
# SSL is mandatory. The app sets/validates collector_core on each connection.
SUPABASE_DATABASE_URL=postgresql+psycopg://collector_runtime.PROJECT_REF:REPLACE_ME@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# One-off bootstrap only; DO NOT expose this URL to API/Crawlab/worker.
SUPABASE_MIGRATION_DATABASE_URL=
MINIO_ACCESS_KEY=localminio
MINIO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
CLICKHOUSE_USER=ozon
CLICKHOUSE_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
API_KEY=REPLACE_WITH_LONG_RANDOM_OPERATOR_KEY
VIEWER_KEY=REPLACE_WITH_DIFFERENT_VIEWER_KEY
ADMIN_KEY=REPLACE_WITH_DIFFERENT_ADMIN_KEY
DATASET_VERSION=mock-v1
MAX_QUEUE_BACKLOG=10000
# Set to a reviewed immutable digest in production, e.g. crawlabteam/crawlab@sha256:...
CRAWLAB_IMAGE=crawlabteam/crawlab:latest
